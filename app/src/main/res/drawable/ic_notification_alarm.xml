<!--
  The alarm's status-bar icon: an alarm clock, drawn as one solid white shape.

  This is NOT the same kind of drawing as ic_bottom_alarm.xml, and the difference is the whole
  reason the file exists. The tab icon is a 1px outline with no fill, which reads beautifully at
  25dp inside the app. Android treats a notification's small icon completely differently: it throws
  away every colour in it and keeps only the shape, painting that shape in the system's own tint.
  A stroke-only drawing survives that as a few hairlines and all but disappears in the status bar.

  So everything here is filled, not stroked. The clock hands are holes punched through the solid
  body (android:fillType="evenOdd" is what turns the second subpath into a hole rather than a second
  blob), because white hands drawn on a white face would be invisible.

  #FFFFFFFF is not a design choice and is not a theme colour the app could have used instead — the
  system replaces it wherever the icon is drawn. Solid white is simply the convention that makes the
  silhouette come out right everywhere, including in the Android Studio preview.

  Sized 24dp on a 24x24 viewport, which is the size Android expects of a notification small icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- The clock body, with the two hands punched out of it as one L-shaped hole. -->
  <path
      android:fillColor="#FFFFFFFF"
      android:fillType="evenOdd"
      android:pathData="M12,6A7.5,7.5 0 1,0 12,21A7.5,7.5 0 1,0 12,6ZM11.35,8.6L12.65,8.6L12.65,13.1L15.6,13.1L15.6,14.4L11.35,14.4Z"/>

  <!-- The left bell, peeking out above the body. -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M6.3,3A2.6,2.6 0 1,0 6.3,8.2A2.6,2.6 0 1,0 6.3,3Z"/>

  <!-- The right bell. -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M17.7,3A2.6,2.6 0 1,0 17.7,8.2A2.6,2.6 0 1,0 17.7,3Z"/>

  <!-- The two feet the clock stands on. -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M5.9,19.8L7.7,21.1L6.2,23.1L4.4,21.8ZM18.1,19.8L16.3,21.1L17.8,23.1L19.6,21.8Z"/>

</vector>
